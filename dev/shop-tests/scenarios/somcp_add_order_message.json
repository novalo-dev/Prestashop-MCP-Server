{
  "calls": [
    {"why": "a private message on a demo order, kept for the shop and emailed to nobody", "arguments": {"id_order": 1, "message": "Shop test: packed on Monday.", "display_to_customer": false}, "expect": "ok", "contains": ["\"added\": true", "\"display_to_customer\": false", "\"email_sent\": false", "\"id_customer_message\""]},
    {"why": "a message shown to the customer, the order found by its reference", "arguments": {"reference": "UOYEVOLI", "message": "Your parcel leaves tomorrow.\nThank you for your patience.", "display_to_customer": true}, "expect": "ok", "contains": ["\"added\": true", "\"display_to_customer\": true", "\"email_sent\": true", "\"reference\": \"UOYEVOLI\"", "\"warning\": null"]},
    {"why": "a second message on the same order goes in the thread it already has", "arguments": {"id_order": 1, "message": "Shop test: second note.", "display_to_customer": false}, "expect": "ok", "contains": ["\"added\": true", "\"id_customer_thread\""]},
    {"why": "a message holding a script is refused", "arguments": {"id_order": 1, "message": "Hello <script>alert(1)</script>", "display_to_customer": false}, "expect": "error", "contains": ["Nothing was sent", "script"]},
    {"why": "a message holding an event attribute is refused", "arguments": {"id_order": 1, "message": "<b onclick=\"x()\">Hello</b>", "display_to_customer": false}, "expect": "error", "contains": ["Nothing was sent"]},
    {"why": "longer than the 1200 characters of the field", "arguments": {"id_order": 1, "message": "", "display_to_customer": false}, "expect": "error", "contains": ["1200 characters"]},
    {"why": "a message of spaces only is empty", "arguments": {"id_order": 1, "message": "   ", "display_to_customer": false}, "expect": "error", "contains": ["the message is empty"]},
    {"why": "a message that is not a string", "arguments": {"id_order": 1, "message": 12345, "display_to_customer": false}, "expect": "error", "contains": ["message must be a string"]},
    {"why": "display_to_customer left out is not read as private", "arguments": {"id_order": 1, "message": "Hello"}, "expect": "error", "contains": ["display_to_customer must be true"]},
    {"why": "display_to_customer as a string is not read as true", "arguments": {"id_order": 1, "message": "Hello", "display_to_customer": "false"}, "expect": "error", "contains": ["display_to_customer must be true"]},
    {"why": "an order that does not exist", "arguments": {"id_order": 999999, "message": "Hello", "display_to_customer": false}, "expect": "error", "contains": ["No order of this shop"]},
    {"why": "neither an identifier nor a reference", "arguments": {"message": "Hello", "display_to_customer": false}, "expect": "error", "contains": ["No order of this shop"]}
  ]
}
