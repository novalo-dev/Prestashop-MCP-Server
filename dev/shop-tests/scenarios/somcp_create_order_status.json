{
  "calls": [
    {"why": "a status in two languages, with its colour, the paid box, an email and its template", "arguments": {"color": "#3C8DBC", "languages": ["en", "fr"], "name": {"en": "Somcp awaiting review", "fr": "Somcp en attente de révision"}, "paid": true, "send_email": true, "template": {"en": "order_conf", "fr": "order_conf"}}, "expect": "ok", "contains": ["\"created\": true", "\"id_order_state\"", "\"name\": \"Somcp awaiting review\"", "\"color\": \"#3C8DBC\"", "\"paid\": true", "\"sends_email\": true", "\"email_template\": \"order_conf\"", "\"icon\": null"]},
    {"why": "the name as one string when one language is filled, every box off as on the empty form", "arguments": {"languages": ["en"], "name": "Somcp plain status"}, "expect": "ok", "contains": ["\"created\": true", "\"name\": \"Somcp plain status\"", "\"color\": \"\"", "\"paid\": false", "\"sends_email\": false", "\"email_template\": \"\""]},
    {"why": "every box on, in_transit included", "arguments": {"languages": ["en"], "logable": true, "invoice": true, "hidden": true, "send_email": true, "pdf_invoice": true, "pdf_delivery": true, "shipped": true, "paid": true, "in_transit": true, "name": {"en": "Somcp everything"}, "template": {"en": "order_conf"}}, "expect": "ok", "contains": ["\"created\": true", "\"counts_as_valid\": true", "\"invoice\": true", "\"hidden_from_customer\": true", "\"attaches_invoice_pdf\": true", "\"attaches_delivery_slip_pdf\": true", "\"shipped\": true", "\"in_transit\": true"]},
    {"why": "an icon by an upload_ref the shop does not know: the status is created, the icon refused and reported", "arguments": {"icon": {"upload_ref": "somcp-test-unknown"}, "languages": ["en"], "name": {"en": "Somcp flagged"}}, "expect": "ok", "contains": ["\"created\": true", "\"upload_ref\": \"somcp-test-unknown\"", "\"refused\": \"no file of this account matches this upload_ref", "\"icon\": null"]},
    {"why": "an icon at an address inside the network: refused, the status stands without one", "arguments": {"icon": {"url": "https://127.0.0.1/icon.gif"}, "languages": ["en"], "name": {"en": "Somcp local icon"}}, "expect": "ok", "contains": ["\"created\": true", "\"url\": \"https://127.0.0.1/icon.gif\"", "\"refused\": \"the host resolves to a private, local or reserved address\""]},
    {"why": "an icon over plain http is refused too", "arguments": {"icon": {"url": "http://example.com/icon.gif"}, "languages": ["en"], "name": {"en": "Somcp http icon"}}, "expect": "ok", "contains": ["\"created\": true", "\"refused\": \"only public https addresses are accepted\""]},
    {"why": "a template without the email box is stored empty, as the form leaves it", "arguments": {"languages": ["en"], "name": {"en": "Somcp quiet"}, "template": {"en": "order_conf"}}, "expect": "ok", "contains": ["\"created\": true", "\"sends_email\": false", "\"email_template\": \"\""]},
    {"why": "the same name again is refused, two statuses could not be told apart", "arguments": {"languages": ["en"], "name": {"en": "Somcp awaiting review"}}, "expect": "error", "contains": ["Nothing was created", "already has this name", "id_order_state"]},
    {"why": "the name of a built-in status", "arguments": {"languages": ["en"], "name": {"en": "Payment accepted"}}, "expect": "error", "contains": ["Nothing was created", "name (en): an order status already has this name, id_order_state 2"]},
    {"why": "a template that does not exist", "arguments": {"languages": ["en"], "name": {"en": "Somcp templated"}, "send_email": true, "template": {"en": "somcp_no_such_template"}}, "expect": "error", "contains": ["Nothing was created", "template (en): \"somcp_no_such_template\" is not one of the mail templates of en"]},
    {"why": "a box that is not a boolean", "arguments": {"languages": ["en"], "name": {"en": "Somcp boxed"}, "paid": "yes"}, "expect": "error", "contains": ["Nothing was created", "paid: true or false"]},
    {"why": "a colour that is not a hex code", "arguments": {"color": "red", "languages": ["en"], "name": {"en": "Somcp red"}}, "expect": "error", "contains": ["Nothing was created", "color: a hex code such as #E84C3D"]},
    {"why": "no name", "arguments": {"languages": ["en"]}, "expect": "error", "contains": ["Nothing was created", "name: required"]},
    {"why": "a name too long", "arguments": {"languages": ["en"], "name": {"en": "Somcp order status whose name goes on and on past the sixty four chars allowed"}}, "expect": "error", "contains": ["name (en): 64 characters at most"]},
    {"why": "forbidden characters in the name", "arguments": {"languages": ["en"], "name": {"en": "Somcp <bad>"}}, "expect": "error", "contains": ["name (en): a character PrestaShop refuses in an order status name"]},
    {"why": "an icon with both a url and an upload_ref", "arguments": {"icon": {"url": "https://example.com/icon.gif", "upload_ref": "somcp-test-unknown"}, "languages": ["en"], "name": {"en": "Somcp two doors"}}, "expect": "error", "contains": ["Nothing was created", "icon: url or upload_ref, not both"]},
    {"why": "an icon given as a plain address instead of an object", "arguments": {"icon": "https://example.com/icon.gif", "languages": ["en"], "name": {"en": "Somcp string icon"}}, "expect": "error", "contains": ["Nothing was created", "icon: an object with url or upload_ref"]},
    {"why": "a computed field and a field this tool does not know", "arguments": {"id_order_state": 9, "languages": ["en"], "module_name": "ps_check", "name": {"en": "Somcp extra"}}, "expect": "error", "contains": ["id_order_state: worked out by the shop", "module_name: not a field of this tool"]},
    {"why": "a language the shop does not have", "arguments": {"languages": ["zz"], "name": {"en": "Somcp"}}, "expect": "error", "contains": ["not an active language"]}
  ]
}
