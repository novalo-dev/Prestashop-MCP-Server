    {"why": "the texts read in a language the shop has, said by its code", "arguments": {"language": "en"}, "expect": "ok", "contains": ["\"language\": \"en\""]},
    {"why": "a page category the shop does not have is refused", "arguments": {"id_cms_category": 999999}, "expect": "error", "contains": ["id_cms_category"]},
    {"why": "a non-boolean Displayed filter is refused, naming the field", "arguments": {"active": "yes"}, "expect": "error", "contains": ["active"]},
    {"why": "a language the shop does not have is refused, naming the ones it has", "arguments": {"language": "zz"}, "expect": "error", "contains": ["This language is not one of the shop's", "en"]}
