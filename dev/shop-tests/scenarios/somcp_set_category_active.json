    {"why": "the root category cannot be hidden", "arguments": {"id_category": 1, "active": false}, "expect": "error", "contains": ["Nothing was changed"]},
    {"why": "an identifier given as a list is not read as category 1", "arguments": {"id_category": [5], "active": false}, "expect": "error", "contains": ["No category of this shop"]},
