    {"why": "the same values again change nothing", "arguments": {"id_product": 8, "languages": ["en"], "basics": {"name": {"en": "Somcp renamed mug"}}, "pricing": {"price_tax_excl": 13.5}, "options": {"online_only": true}}, "expect": "ok", "contains": ["\"changed\": false"]},
    {"why": "the sets chosen as a whole, replaced, with an SEO title", "arguments": {"id_product": 6, "languages": ["en"], "categories": {"categories": [3, 4], "id_category_default": 4}, "features": [{"id_feature": 1, "id_feature_value": 1}, {"id_feature": 2, "value": {"en": "Somcp custom value"}}], "related_products": [1], "shipping": {"carriers": [2], "weight": 0.4}, "seo": {"meta_title": {"en": "Somcp updated mug"}}}, "expect": "ok", "contains": ["\"changed\": true", "categories.categories", "features", "shipping.carriers", "Somcp custom value", "seo.meta_title (en)"]},
    {"why": "a supplier with its reference, made the default one", "arguments": {"id_product": 6, "suppliers": {"id_supplier_default": 1, "suppliers": [{"id_supplier": 1, "product_supplier_reference": "SOMCP-UPD-SUP"}]}}, "expect": "ok", "contains": ["\"changed\": true", "SOMCP-UPD-SUP", "\"id_supplier_default\": 1"]},
    {"why": "a specific price added, and the priorities", "arguments": {"id_product": 6, "specific_prices": {"rules": [{"reduction": 0.15, "reduction_type": "percentage"}], "priorities": ["id_group", "id_shop", "id_currency", "id_country"]}}, "expect": "ok", "contains": ["\"changed\": true", "specific_prices.priorities"]},
    {"why": "the stock of a product without combinations", "arguments": {"id_product": 6, "stock": {"quantity": 42, "out_of_stock": "allow"}}, "expect": "ok", "contains": ["\"changed\": true", "stock.quantity", "\"quantity\": 42"]},
    {"why": "a first combination makes the mug a product with combinations", "arguments": {"id_product": 8, "combinations": [{"attributes": [1], "reference": "SOMCP-UPD-S", "quantity": 4}]}, "expect": "ok", "contains": ["\"changed\": true", "\"product_type\": \"combinations\"", "SOMCP-UPD-S"]},
    {"why": "a product that still has combinations cannot become standard", "arguments": {"id_product": 8, "basics": {"product_type": "standard"}}, "expect": "error", "contains": ["remove_combinations"]},
    {"why": "nor take a quantity of its own", "arguments": {"id_product": 1, "stock": {"quantity": 5}}, "expect": "error", "contains": ["stock.quantity"]},
    {"why": "one combination of the demo tee, whose identifier depends on how the demo data was numbered", "arguments": {"id_product": 1, "combinations": [{"id_product_attribute": 1, "price_impact_tax_excl": 2, "minimal_quantity": 2}]}, "expect": "any"},
    {"why": "the customization fields of the customizable demo mug, replaced", "arguments": {"id_product": 19, "languages": ["en"], "customization": {"fields": [{"type": "text", "name": {"en": "Somcp message"}, "required": false}]}}, "expect": "ok", "contains": ["\"changed\": true", "customization.fields", "Somcp message"]},
    {"why": "an image that is refused is reported without stopping the change", "arguments": {"id_product": 6, "languages": ["en"], "images": [{"url": "https://127.0.0.1/mug.jpg"}], "seo": {"meta_description": {"en": "A mug for the shop test."}}}, "expect": "ok", "contains": ["\"changed\": true", "private, local or reserved address"]},
    {"why": "a product that does not exist", "arguments": {"id_product": 999999, "pricing": {"price_tax_excl": 5}}, "expect": "error", "contains": ["No product"]},
    {"why": "a combination, an image and a specific price that are not the product's", "arguments": {"id_product": 6, "combinations": [{"id_product_attribute": 999999, "reference": "SOMCP-NONE"}], "images": [{"id_image": 999999, "cover": true}], "remove_specific_prices": [999999]}, "expect": "error", "contains": ["Nothing was changed", "id_product_attribute", "id_image", "remove_specific_prices"]},
    {"why": "a reference another product uses", "arguments": {"id_product": 6, "references": {"reference": "demo_1"}}, "expect": "error", "contains": ["already used"]},
    {"why": "an empty name, a computed field and an unknown one", "arguments": {"id_product": 6, "languages": ["en"], "basics": {"name": {"en": " "}}, "pricing": {"price_tax_incl": 6}, "colour": "red"}, "expect": "error", "contains": ["basics.name", "pricing.price_tax_incl", "colour"]}
