{
  "calls": [
    {"why": "a built-in status renamed in one language: every return status can be edited, 1 to 5 included", "arguments": {"id_order_return_state": 3, "languages": ["en"], "name": {"en": "Somcp package received"}}, "expect": "ok", "contains": ["\"changed\": true", "\"id_order_return_state\": 3", "\"field\": \"name (en)\"", "\"old\": \"Package received\"", "\"new\": \"Somcp package received\"", "\"name\": \"Somcp package received\""]},
    {"why": "the same call twice: the second one changes nothing and writes nothing", "arguments": {"id_order_return_state": 3, "languages": ["en"], "name": {"en": "Somcp package received"}}, "expect": "ok", "contains": ["\"changed\": false", "\"reason\": \"The return status already holds every value given.\""]},
    {"why": "the built-in status given its name back", "arguments": {"id_order_return_state": 3, "languages": ["en"], "name": {"en": "Package received"}}, "expect": "ok", "contains": ["\"changed\": true", "\"old\": \"Somcp package received\"", "\"new\": \"Package received\""]},
    {"why": "the colour of the status the create scenario made colourless, whose stored colour is empty", "arguments": {"color": "#4169E1", "id_order_return_state": 8}, "expect": "ok", "contains": ["\"changed\": true", "\"field\": \"color\"", "\"old\": \"\"", "\"new\": \"#4169E1\"", "\"color\": \"#4169E1\""]},
    {"why": "a rename in two languages of the same created status; the French text was the default text copied at creation", "arguments": {"id_order_return_state": 8, "languages": ["en", "fr"], "name": {"en": "Somcp colourless renamed", "fr": "Somcp renommé"}}, "expect": "ok", "contains": ["\"changed\": true", "\"field\": \"name (en)\"", "\"old\": \"Somcp colourless\"", "\"field\": \"name (fr)\"", "\"old\": \"Somcp colourless\"", "\"new\": \"Somcp renommé\""]},
    {"why": "the name as one string when one language is filled", "arguments": {"id_order_return_state": 8, "languages": ["en"], "name": "Somcp colourless"}, "expect": "ok", "contains": ["\"changed\": true", "\"old\": \"Somcp colourless renamed\"", "\"name\": \"Somcp colourless\""]},
    {"why": "nothing given changes nothing", "arguments": {"id_order_return_state": 3}, "expect": "ok", "contains": ["\"changed\": false", "\"id_order_return_state\": 3"]},
    {"why": "a status that does not exist", "arguments": {"color": "#4169E1", "id_order_return_state": 999999}, "expect": "error", "contains": ["No return status has this identifier", "Nothing was changed"]},
    {"why": "an identifier that is not a number", "arguments": {"color": "#4169E1", "id_order_return_state": [3]}, "expect": "error", "contains": ["No return status has this identifier"]},
    {"why": "the name of another status is refused, the two steps could not be told apart", "arguments": {"id_order_return_state": 8, "languages": ["en"], "name": {"en": "Package received"}}, "expect": "error", "contains": ["Nothing was changed", "already has this name", "id_order_return_state 3"]},
    {"why": "a colour that is not a hex code", "arguments": {"color": "blue", "id_order_return_state": 8}, "expect": "error", "contains": ["Nothing was changed", "color: a hex code such as #E84C3D"]},
    {"why": "an empty name", "arguments": {"id_order_return_state": 8, "languages": ["en"], "name": {"en": "  "}}, "expect": "error", "contains": ["name: missing in en"]},
    {"why": "a name too long", "arguments": {"id_order_return_state": 8, "languages": ["en"], "name": {"en": "Somcp return status whose name goes on past the sixty four characters allowed"}}, "expect": "error", "contains": ["name (en): 64 characters at most"]},
    {"why": "forbidden characters in the name", "arguments": {"id_order_return_state": 8, "languages": ["en"], "name": {"en": "Somcp <bad>"}}, "expect": "error", "contains": ["name (en): a character PrestaShop refuses in a return status name"]},
    {"why": "a computed field and a field this tool does not know", "arguments": {"id_order_return_state": 8, "removable": true, "template": "x"}, "expect": "error", "contains": ["removable: worked out by the shop", "template: not a field of this tool"]},
    {"why": "a language the shop does not have", "arguments": {"id_order_return_state": 8, "languages": ["zz"], "name": {"en": "Somcp"}}, "expect": "error", "contains": ["not an active language"]}
