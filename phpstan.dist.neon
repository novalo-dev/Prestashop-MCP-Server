# Static analysis against a real PrestaShop.
#
# Needs the dev tools (composer install --working-dir=dev/tools) and the path
# of a PrestaShop folder in _PS_ROOT_DIR_ - an installed shop, or the sources
# of a release with their Composer dependencies, which is what CI analyses
# against, one release and one PHP version per shop job:
#
#   _PS_ROOT_DIR_=/path/to/prestashop dev/tools/vendor/bin/phpstan analyse -c phpstan.dist.neon
#
# The settings themselves are in phpstan-module.neon, shared with PrestaShop's
# own PHPStan action.
includes:
    - dev/tools/vendor/prestashop/php-dev-tools/phpstan/ps-module-extension.neon
    - phpstan-module.neon
