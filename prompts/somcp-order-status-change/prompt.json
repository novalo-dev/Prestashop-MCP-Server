{
  "title": "Change an order status",
  "description": "Change the status of an order in the PrestaShop shop, one order at a time, with the checks that keep a customer from being emailed twice.",
  "scopes": [
    "mcp.orders.write"
  ],
  "tools": [
    "somcp_ping",
    "somcp_list_order_statuses",
    "somcp_create_order_status",
    "somcp_list_return_statuses",
    "somcp_list_carriers",
    "somcp_create_return_status",
    "somcp_get_order",
    "somcp_set_order_status",
    "somcp_set_order_tracking",
    "somcp_add_order_message",
    "somcp_set_order_note",
    "somcp_add_order_payment"
  ],
  "controller": "AdminOrders",
  "action": "edit",
  "arguments": [
    {
      "name": "order",
      "description": "Reference or number of the order",
      "required": false
    },
    {
      "name": "status",
      "description": "Status to set",
      "required": false
    }
  ]
}
